---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
---

<BaseLayout
  title="Services | Strohm Partners"
  description="Missed-call automation, AI reception, CRM follow-up, qualified booking, and custom automation for service SMBs."
>
  <section class="border-b border-border bg-hero-radial py-20 md:py-28">
    <div class="container max-w-4xl">
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Services built for the way you actually get work</h1>
      <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
        Every offer below is <strong class="text-foreground">managed</strong> — we design the workflows, connect your tools, test with real scenarios, and keep the system running. Pick a starting point or book a call and we’ll recommend one.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="container grid gap-6">
      {services.map((service) => (
        <article class="rounded-xl border border-border bg-card p-6 md:p-8">
          <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
            <div class="max-w-2xl">
              <h2 class="text-2xl font-semibold">{service.title}</h2>
              <p class="mt-3 text-muted-foreground leading-relaxed">{service.lede}</p>
              <p class="mt-4 font-mono text-sm text-primary">
                Setup {service.setupRange} · Monthly {service.monthlyRange}
              </p>
            </div>
            <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
              <a href={`/services/${service.slug}`} class="inline-flex h-10 items-center justify-center rounded-lg border border-border px-4 text-sm hover:border-primary/50">Learn more</a>
              <a href={`/contact?interest=${service.interest}`} class="inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm text-primary-foreground">Book a call</a>
            </div>
          </div>
        </article>
      ))}

      <article class="rounded-xl border border-primary/40 bg-primary/5 p-6 md:p-8">
        <h3 class="text-xl font-semibold">Most popular starting point</h3>
        <p class="mt-3 text-muted-foreground leading-relaxed">
          Missed-call text-back plus CRM pipeline and follow-up sequences. You capture the lead in the first minute and nurture it until it books or opts out.
        </p>
        <a href="/contact" class="mt-6 inline-flex h-11 items-center justify-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground">Book a call</a>
      </article>
    </div>
  </section>
</BaseLayout>
